from pathlib import Path

def create_tracked_script(original_script_path, output_script_path, timeout_seconds=30):
    with open(original_script_path, 'r', encoding='utf-8') as f:
        original_content = f.read()
    
    original_lines = original_content.splitlines()
    
    # Find where to insert our tracking imports
    import_index = 0
    for i, line in enumerate(original_lines):
        if line.startswith(('import ', 'from ')):
            import_index = i + 1
        elif line.strip() and not line.startswith(('def ', 'class ')):
            break
    
    tracking_imports = [
        'from pathlib import Path',
        'import traceback',
        'import sys',
        'import os',
        'from io import StringIO',
        'from contextlib import redirect_stdout, redirect_stderr',
        'import threading',
        'from queue import Queue',
        'import time',
        'import ctypes',
        ''
    ]
    
    # Insert imports after the first import block
    modified_lines = (original_lines[:import_index] + 
                     tracking_imports + 
                     original_lines[import_index:])
    
    # Find the start of the main code (after imports and function definitions)
    code_start = 0
    for i, line in enumerate(modified_lines):
        line = line.strip()
        if line and not (line.startswith('import ') or line.startswith('from ') or 
                        line.startswith('def ') or line.startswith('class ')):
            code_start = i - 1
            break
    
    # Prepare the tracking code to insert at the beginning of the main code
    tracking_code = [
        'def main():',
        '    # Debug information',
        '    print("Script started")',
        '    print(f"Working directory: {os.getcwd()}")',
        '    print(f"Script location: {__file__}")',
        '',
        '    # Setup output and error tracking',
        '    output = StringIO()',
        '    error_output = StringIO()',
        '    sys.stdout = output',
        '    sys.stderr = error_output',
        '    output_file = Path(__file__).parent / "output.txt"',
        '    error_file = Path(__file__).parent / "errorMessage.txt"',
        '    html_file = Path(__file__).parent / "HTML.txt"',
        '    timeout_seconds = ' + str(timeout_seconds),
        '    page = None  # Initialize page variable',
        '    browser = None  # Initialize browser variable',
        '    playwright = None  # Initialize playwright instance',
        '    queue = Queue()  # Initialize thread-safe queue for HTML content',
        '',
        '    def save_page_html(page, html_file, queue):',
        '        """Thread-safe function to save page HTML using a queue."""',
        '        try:',
        '            if page and not page.is_closed():',
        '                content = page.evaluate(\'document.documentElement.outerHTML\')',
        '                queue.put((\'html\', content, str(html_file)))',
        '        except Exception as e:',
        '            queue.put((\'error\', f"Error saving HTML: {str(e)}", str(html_file)))',
        '',
        '    def save_outputs():',
        '        """Save output and error messages to files."""',
        '        try:',
        '            output_dir = Path(__file__).parent',
        '            output_dir.mkdir(parents=True, exist_ok=True)',
        '            with open(output_file, "w", encoding="utf-8") as f:',
        '                f.write(output.getvalue())',
        '            error_content = error_output.getvalue()',
        '            if error_content:',
        '                with open(error_file, "w", encoding="utf-8") as f:',
        '                    f.write("=== STDERR ===\\n" + error_content + "\\n=== TRACEBACK ===\\n" + traceback.format_exc())',
        '        except Exception as e:',
        '            print(f"Error saving outputs: {str(e)}", file=sys.stderr)',
        '',
        '    def process_queue(queue):',
        '        """Process all items in the queue with error handling"""',
        '        while not queue.empty():',
        '            item_type, content, file_path = queue.get()',
        '            try:',
        '                if item_type == \'html\':',
        '                    with open(file_path, \'w\', encoding=\'utf-8\') as f:',
        '                        f.write(content)',
        '                        f.flush()',
        '                        os.fsync(f.fileno())',
        '                elif item_type == \'error\':',
        '                    with open(file_path, \'w\', encoding=\'utf-8\') as f:',
        '                        f.write(content)',
        '            except Exception as e:',
        '                print(f"Error processing queue item: {e}", file=sys.stderr)',
        '',
        '    def html_saver_thread(page, html_file, queue, stop_event, save_interval=1):',
        '        """Background thread that periodically saves the page HTML"""',
        '        while not stop_event.is_set():',
        '            try:',
        '                if page and not page.is_closed():',
        '                    save_page_html(page, html_file, queue)',
        '                    process_queue(queue)',
        '            except Exception as e:',
        '                print(f"Error in HTML saver thread: {e}", file=sys.stderr)',
        '            stop_event.wait(save_interval)',
        '',
        '    timed_out = False',
        '    timer = None',
        '    queue = Queue()',
        '',
        '    # Create stop event for the HTML saver thread',
        '    stop_event = threading.Event()',
        '',
        '    # Start the HTML saver thread',
        '    html_saver = threading.Thread(',
        '        target=html_saver_thread,',
        '        args=(page, html_file, queue, stop_event),',
        '        daemon=True',
        '    )',
        '    html_saver.start()',
        '',
        '    try:',
        '        with sync_playwright() as p:',
        '            playwright = p',
        '            browser = p.chromium.launch(headless=False, timeout=timeout_seconds * 1000)',
        '            page = browser.new_page()',
        '            page.set_default_timeout(timeout_seconds * 1000)',
        '',
        '            def timeout_handler():',
        '                nonlocal timed_out',
        '                timed_out = True',
        '                try:',
        '                    if page and not page.is_closed():',
        '                        try:',
        '                            save_page_html(page, html_file, queue)',
        '                            process_queue(queue)',
        '                            sys.stdout = sys.__stdout__',
        '                            sys.stderr = sys.__stderr__',
        '                            save_outputs()',
        '                        except Exception as save_error:',
        '                            print(f"Error saving state before timeout: {str(save_error)}", file=sys.stderr)',
        '                        try:',
        '                            page.evaluate("window.stop()")',
        '                        except:',
        '                            pass',
        '                except Exception as e:',
        '                    print(f"Error in timeout handler: {str(e)}", file=sys.stderr)',
        '                finally:',
        '                    os._exit(1)',
        '',
        '            timer = threading.Timer(',
        '                timeout_seconds,',
        '                timeout_handler,',
        '            )',
        '            timer.daemon = True',
        '            timer.start()'
    ]

    # Prepare the code to insert at the end of the main code
    end_code = [
        '            # Save HTML after successful execution',
        '            if page and not page.is_closed():',
        '                save_page_html(page, html_file, queue)',
        '                # Process any queued items',
        '                while not queue.empty():',
        '                    item_type, content, file_path = queue.get()',
        '                    if item_type == \'html\':',
        '                        with open(file_path, \'w\', encoding=\'utf-8\') as f:',
        '                            f.write(content)',
        '                    elif item_type == \'error\':',
        '                        with open(file_path, \'w\', encoding=\'utf-8\') as f:',
        '                            f.write(content)',
        '            if browser and browser.is_connected():',
        '                browser.close()',
        '    except Exception as e:',
        '        error_msg = f"\\nERROR: {str(e)}\\n{traceback.format_exc()}"',
        '        print(error_msg, file=sys.stderr)',
        '        if page and not page.is_closed() and not timed_out:',
        '            save_page_html(page, html_file, queue)',
        '            # Process any queued items from error case',
        '            while not queue.empty():',
        '                item_type, content, file_path = queue.get()',
        '                if item_type == \'html\':',
        '                    with open(file_path, \'w\', encoding=\'utf-8\') as f:',
        '                        f.write(content)',
        '                elif item_type == \'error\':',
        '                    with open(file_path, \'w\', encoding=\'utf-8\') as f:',
        '                        f.write(content)',
        '        if browser and browser.is_connected():',
        '            browser.close()',
        '    finally:',
        '        # Signal the HTML saver to stop',
        '        if \'stop_event\' in locals():',
        '            stop_event.set()',
        '        ',
        '        # Wait for the saver thread to finish (with a timeout)',
        '        if \'html_saver\' in locals():',
        '            html_saver.join(timeout=2)',
        '        ',
        '        # Clean up timer if it exists',
        '        if \'timer\' in locals() and timer is not None:',
        '            try:',
        '                timer.cancel()',
        '            except:',
        '                pass',
        '        ',
        '        # Process any remaining queue items',
        '        if \'queue\' in locals():',
        '            try:',
        '                process_queue(queue)',
        '            except Exception as e:',
        '                print(f"Error processing final queue: {e}", file=sys.stderr)',
        '        ',
        '        # Restore stdout/stderr and save outputs',
        '        sys.stdout = sys.__stdout__',
        '        sys.stderr = sys.__stderr__',
        '        if \'save_outputs\' in locals():',
        '            try:',
        '                save_outputs()',
        '            except Exception as e:',
        '                print(f"Error saving final outputs: {e}", file=sys.stderr)',
        '        ',
        '        # Close browser if still open',
        '        try:',
        '            if \'browser\' in locals() and browser and browser.is_connected():',
        '                browser.close()',
        '        except Exception as e:',
        '            print(f"Error closing browser: {e}", file=sys.stderr)',
        '        ',
        '        if \'timed_out\' in locals() and timed_out:',
        '            os._exit(1)',
        '',
        'if __name__ == "__main__":',
        '    main()'
    ]
    
    # Start building the final script
    final_script = []
    
    # 1. Add original imports and function definitions
    final_script.extend(modified_lines[:code_start])
    
    # 2. Add tracking code (main function definition)
    final_script.extend(tracking_code)
    
    # 3. Add the original code with proper indentation and modify Playwright usage
    in_function = False
    current_indent = 0
    for line in modified_lines[code_start:]:
        line = line.rstrip()
        
        # Skip main function call if present
        if line.strip() in ('if __name__ == "__main__":', 'main()'):
            continue
            
        # Skip any existing Playwright setup
        if any(playwright_line in line for playwright_line in [
            'with sync_playwright() as p:',
            'p.chromium.launch(',
            'browser = p.chromium.launch(',
            'page = browser.new_page()',
            'browser.close()'
        ]):
            continue
        
        # Get the current line's indentation level
        line_indent = len(line) - len(line.lstrip())
        
        # Track function definitions
        if line.strip().startswith('def '):
            in_function = True
            # Add the function definition with proper indentation
            final_script.append('        ' + line)
            # Track the base indentation of this function
            current_indent = line_indent
            continue

        # Check if we've exited the function's indentation level
        if in_function and line_indent <= current_indent and line.strip() and not line.strip().startswith(('def ', 'class ')):
            in_function = False
            current_indent = line_indent
            
        if line.strip():
            # Preserve the original indentation, but ensure it's at least at the main() level
            final_script.append((' ' * (8 + line_indent - current_indent)) + line.lstrip())

    # 4. Add the end code (rest of main function and main call)
    final_script.extend(end_code)
    
    # Write the final script
    with open(output_script_path, 'w', encoding='utf-8') as f:
        f.write('\n'.join(final_script))